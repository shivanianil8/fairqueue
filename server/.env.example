# ==============================================================================
# FAIRQUEUE - Intelligent Queue Fairness Analyzer
# Production Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5050
NODE_ENV=production

# Persistence Configuration
# If MONGODB_URI / DATABASE_URL is unset, FAIRQUEUE operates in high-performance in-memory mode
DATABASE_URL=mongodb://localhost:27017/fairqueue
MONGODB_URI=mongodb://localhost:27017/fairqueue

# Cryptographic Authentication Security
# Generate a secure 64-character secret with: openssl rand -hex 32
AUTH_SECRET=fairqueue-super-secret-production-encryption-key-change-me-immediately-in-prod
SESSION_MAX_AGE_DAYS=7

# Client Application URL (for CORS and email callback URLs)
FRONTEND_URL=https://fairqueue.example.com

# Transactional Email Configuration (Optional - Falls back to secure console logs in dev mode)
EMAIL_FROM=notifications@fairqueue.example.com
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
